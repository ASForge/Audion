<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnScanFolders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Pindai Semua Folder Musik"
        android:contentDescription="Pindai semua folder musik di penyimpanan internal dan kartu SD" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tekan tombol pindai untuk memuat daftar folder."
        android:textSize="15sp"
        android:importantForAccessibility="yes" />

    <!-- Bagian informasi lagu yang sedang diputar -->
    <TextView
        android:id="@+id/tvTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Judul Lagu: Belum ada lagu diputar"
        android:textSize="18sp"
        android:textStyle="bold"
        android:importantForAccessibility="yes" />

    <TextView
        android:id="@+id/tvTrackArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Penyanyi: -"
        android:textSize="16sp"
        android:importantForAccessibility="yes" />

    <TextView
        android:id="@+id/tvTrackAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Album: -"
        android:textSize="16sp"
        android:importantForAccessibility="yes" />

    <!-- Baris kontrol utama: Previous, Rewind, Play/Pause, Forward, Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Prev"
            android:contentDescription="Lagu sebelumnya" />

        <Button
            android:id="@+id/btnRewind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Rew"
            android:contentDescription="Mundur 10 detik" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Play"
            android:contentDescription="Putar atau jeda lagu" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Fwd"
            android:contentDescription="Maju 10 detik" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Next"
            android:contentDescription="Lagu berikutnya" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

</LinearLayout>